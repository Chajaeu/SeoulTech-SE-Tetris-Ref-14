<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<!--
    상위 10위 기록 대상일 때 표시할 이름 입력 팝업.
    Java 연결 필요: 예상 순위, 현재 모드와 최종 점수 표시, 이름 검증, 등록/닫기 동작.
    API 연동 필요: 기록 대상 확인, 이름과 점수 저장, 점수판 갱신 및 새 기록 강조.
    이 FXML에는 컨트롤러나 API 호출을 연결하지 않는다.
-->

<AnchorPane fx:id="scoreSubmitRoot" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="340.0" prefWidth="440.0" style="-fx-background-color: linear-gradient(to bottom, #F7FBFF 0%, #DCEAF5 55%, #B8CBDD 100%); -fx-border-color: #173765; -fx-border-width: 6; -fx-border-radius: 12; -fx-background-radius: 15; -fx-font-family: 'Segoe UI';" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <!-- API 연동 필요: 해당 모드/난이도의 예상 순위를 조회하여 rankLabel에 "RANK 3"처럼 표시한다. 조회 전에는 임의의 순위를 표시하지 않는다. -->
        <HBox alignment="CENTER_LEFT" layoutX="32.0" layoutY="42.0" prefHeight="36.0" prefWidth="376.0" spacing="12.0">
            <children>
                <Label fx:id="rankLabel" minWidth="-Infinity" prefHeight="39.0" prefWidth="258.0" style="-fx-font-family: 'Arial Black'; -fx-font-size: 26px; -fx-text-fill: #10204A;" text="RANK —" />
                <Region prefHeight="39.0" prefWidth="79.0" HBox.hgrow="ALWAYS" />
                <!-- Java 연결 필요: 기록을 제출하는 현재 모드 이름을 modeLabel에 표시한다. -->
                <Label fx:id="modeLabel" alignment="CENTER" minWidth="-Infinity" prefHeight="32.0" prefWidth="89.0" style="-fx-background-color: #B8CBDD; -fx-background-radius: 5; -fx-font-family: 'Arial Black'; -fx-font-size: 14px; -fx-text-fill: #10204A; -fx-padding: 4 10 4 10;" text="MODE — " />
            </children>
        </HBox>
        <Button fx:id="closeButton" accessibleText="닫기" layoutX="391.0" layoutY="12.0" mnemonicParsing="false" prefHeight="30.0" prefWidth="32.0" style="-fx-background-color: transparent; -fx-text-fill: #10204A; -fx-font-size: 16px; -fx-font-weight: bold;" text="X" />

        <HBox alignment="CENTER_LEFT" layoutX="32.0" layoutY="99.0" prefHeight="60.0" prefWidth="376.0" style="-fx-background-color: #E8F1F8; -fx-border-color: #173765; -fx-border-width: 2; -fx-border-radius: 6; -fx-background-radius: 7;">
            <padding>
                <Insets bottom="8.0" left="16.0" right="16.0" top="8.0" />
            </padding>
            <children>
                <Label style="-fx-font-family: 'Arial Black'; -fx-font-size: 14px; -fx-text-fill: #365679;" text="SCORE" />
                <Region HBox.hgrow="ALWAYS" />
                <!-- 최종 점수는 Java에서 scoreLabel의 text로 설정한다. -->
                <Label fx:id="scoreLabel" alignment="CENTER_RIGHT" style="-fx-font-family: 'Arial Black'; -fx-font-size: 28px; -fx-text-fill: #10204A;" text="—" />
            </children>
        </HBox>

        <Label layoutX="32.0" layoutY="175.0" prefHeight="22.0" style="-fx-font-family: 'Arial Black'; -fx-font-size: 13px; -fx-text-fill: #10204A;" text="NAME" />
        <TextField fx:id="nameField" accessibleText="닉네임" layoutX="32.0" layoutY="201.0" prefHeight="40.0" prefWidth="376.0" promptText="닉네임을 입력하세요" style="-fx-background-color: #FFFFFF; -fx-background-radius: 5; -fx-border-color: #315B78; -fx-border-width: 2; -fx-border-radius: 5; -fx-font-size: 16px; -fx-text-fill: #10204A; -fx-prompt-text-fill: #617891; -fx-padding: 7 12 7 12;" />
        <!-- 이름 검증 실패 시 Java에서 안내 문구를 설정한다. -->
        <Label fx:id="errorLabel" layoutX="32.0" layoutY="245.0" prefHeight="22.0" prefWidth="376.0" style="-fx-font-size: 12px; -fx-text-fill: #9E3030;" text="" />

        <HBox alignment="CENTER" layoutX="32.0" layoutY="276.0" prefHeight="40.0" prefWidth="376.0" spacing="12.0">
            <children>
                <Button fx:id="submitButton" defaultButton="true" mnemonicParsing="false" prefHeight="40.0" prefWidth="232.0" style="-fx-background-color: linear-gradient(to bottom, #FFF06A 0%, #FFD329 45%, #FF9D0A 100%); -fx-text-fill: #10204A; -fx-font-family: 'Arial Black'; -fx-font-size: 13px; -fx-border-color: #173765; -fx-border-width: 2; -fx-border-radius: 6; -fx-background-radius: 7;" text="SAVE SCORE" />
            </children>
        </HBox>
    </children>
</AnchorPane>
